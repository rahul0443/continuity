# Copy this file to .env and fill in your own key. Never commit the real .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Retrieval tuning
RETRIEVAL_TOP_K=5
# Fused RRF score below this on the top result auto-escalates without an LLM
# triage call (cheap heuristic gate before spending a model call).
MIN_FUSED_SCORE_THRESHOLD=0.02
